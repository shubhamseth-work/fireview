{
  "name": "@vistiq/auth",
  "version": "0.1.0",
  "description": "Authentication providers for Vistiq",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src",
    "format:check": "prettier --check src"
  },
  "keywords": ["vistiq", "auth", "firebase", "oauth"],
  "author": "Vistiq Contributors",
  "license": "Apache-2.0",
  "devDependencies": {
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@vistiq/core": "workspace:*",
    "@vistiq/shared": "workspace:*",
    "@vistiq/credentials": "workspace:*",
    "firebase-admin": "^11.11.0",
    "google-auth-library": "^9.4.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}