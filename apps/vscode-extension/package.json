{
  "name": "fire-view",
  "displayName": "FireView",
  "publisher": "fireview",
  "version": "0.1.5",
  "description": "FireView - Explore. Query. Manage. Firebase Firestore developer workspace for VS Code.",
  "main": "dist/extension.js",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "clean": "rm -rf dist",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "package": "vsce package",
    "watch": "node esbuild.config.mjs --watch"
  },
  "keywords": [
    "fireview",
    "vscode",
    "extension",
    "firestore"
  ],
  "author": "FireView Contributors",
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.21.5",
    "eslint-plugin-prettier": "^5.5.6",
    "sharp": "^0.35.3",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0",
    "vsce": "^2.15.0"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "dependencies": {
    "@fireview/audit": "*",
    "@fireview/auth": "*",
    "@fireview/batch": "*",
    "@fireview/core": "*",
    "@fireview/credentials": "*",
    "@fireview/diff": "*",
    "@fireview/emulator": "*",
    "@fireview/export": "*",
    "@fireview/firestore": "*",
    "@fireview/import": "*",
    "@fireview/migration": "*",
    "@fireview/project-compare": "*",
    "@fireview/query-builder": "*",
    "@fireview/query-engine": "*",
    "@fireview/shared": "*",
    "firebase-admin": "^11.11.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "fireview.connectProject",
        "title": "FireView: Connect Project",
        "icon": "$(cloud)"
      },
      {
        "command": "fireview.disconnectProject",
        "title": "FireView: Disconnect Project",
        "icon": "$(plug)"
      },
      {
        "command": "fireview.disconnectAllProjects",
        "title": "FireView: Disconnect All Projects",
        "icon": "$(plug)"
      },
      {
        "command": "fireview.disconnectSpecificProject",
        "title": "FireView: Disconnect Specific Project",
        "icon": "$(plug)"
      },
      {
        "command": "fireview.refresh",
        "title": "FireView: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "fireview.refreshProject",
        "title": "FireView: Refresh Project",
        "icon": "$(refresh)"
      },
      {
        "command": "fireview.openFirestore",
        "title": "FireView: Open Firestore"
      },
      {
        "command": "fireview.newDocument",
        "title": "FireView: New Document"
      },
      {
        "command": "fireview.runQuery",
        "title": "FireView: Run Query"
      },
      {
        "command": "fireview.saveQuery",
        "title": "FireView: Save Query"
      },
      {
        "command": "fireview.exportCollection",
        "title": "FireView: Export Collection"
      },
      {
        "command": "fireview.importCollection",
        "title": "FireView: Import Collection"
      },
      {
        "command": "fireview.compareDocuments",
        "title": "FireView: Compare Documents"
      },
      {
        "command": "fireview.compareProjects",
        "title": "FireView: Compare Projects"
      },
      {
        "command": "fireview.copyToProject",
        "title": "FireView: Copy to Project"
      },
      {
        "command": "fireview.openAuditHistory",
        "title": "FireView: Open Audit History"
      },
      {
        "command": "fireview.openDocument",
        "title": "FireView: Open Document"
      },
      {
        "command": "fireview.settings",
        "title": "FireView: Settings"
      }
    ],
    "keybindings": [
      {
        "command": "fireview.refresh",
        "key": "ctrl+r",
        "mac": "cmd+r",
        "when": "viewContainer == fireview"
      },
      {
        "command": "fireview.newDocument",
        "key": "ctrl+n",
        "mac": "cmd+n",
        "when": "viewContainer == fireview"
      },
      {
        "command": "fireview.runQuery",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "viewContainer == fireview"
      },
      {
        "command": "fireview.openFirestore",
        "key": "ctrl+k ctrl+f",
        "mac": "cmd+k cmd+f"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "fireview",
          "title": "FireView",
          "icon": "resources/icon.png"
        }
      ]
    },
    "views": {
      "fireview": [
        {
          "id": "fireview.projects",
          "name": "Projects",
          "contextualTitle": "Projects"
        },
        {
          "id": "fireview.tools",
          "name": "Tools"
        },
        {
          "id": "fireview.settings",
          "name": "Settings"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "fireview.connectProject",
          "when": "view == fireview.projects",
          "group": "navigation"
        },
        {
          "command": "fireview.disconnectProject",
          "when": "view == fireview.projects",
          "group": "navigation"
        },
        {
          "command": "fireview.refresh",
          "when": "view == fireview.projects",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "fireview.connectProject",
          "when": "view == fireview.projects && viewItem == empty",
          "group": "inline"
        },
        {
          "command": "fireview.disconnectSpecificProject",
          "when": "view == fireview.projects && (viewItem == project || viewItem == emulatorProject || viewItem == productionProject)",
          "group": "inline"
        },
        {
          "command": "fireview.refreshProject",
          "when": "view == fireview.projects && (viewItem == project || viewItem == emulatorProject || viewItem == productionProject)",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "FireView",
      "properties": {
        "fireview.defaultPageSize": {
          "type": "number",
          "default": 50,
          "description": "Default number of documents per page"
        },
        "fireview.productionSafetyMode": {
          "type": "boolean",
          "default": true,
          "description": "Enable production safety confirmations"
        },
        "fireview.enableDebugLogging": {
          "type": "boolean",
          "default": false,
          "description": "Enable debug logging"
        }
      }
    }
  },
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/shubhamseth-work/fireview.git"
  },
  "bugs": {
    "url": "https://github.com/shubhamseth-work/fireview/issues"
  },
  "homepage": "https://github.com/shubhamseth-work/fireview#readme"
}
