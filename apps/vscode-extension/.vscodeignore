# Ignore everything outside extension directory
../
../../

# Ignore root config files
**/.eslintrc.json
**/.prettierrc
**/.gitignore
**/tsconfig.json
**/tsconfig.tsbuildinfo

# Ignore standard files
**/node_modules/**
**/.git/**
**/*.log
**/coverage/**
**/.vscode/**
**/.idea/**
**/*.vsix

# Ignore build configs (not needed at runtime)
esbuild.config.mjs
tsconfig.json
tsconfig.tsbuildinfo

# Ignore source files (not needed at runtime)
src/**

# Ignore source maps (not needed in production)
*.map
dist/**/*.map
dist/*.map

# Keep only extension runtime files
!resources/**
!dist/extension.js
!dist/package.json
!dist/resources/**
!dist/webview/**
!package.json
!README.md
!LICENSE*
!CHANGELOG*
!vsc-extension-quickstart.md